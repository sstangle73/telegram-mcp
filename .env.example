# Copy to .env (never committed). For login.py, local runs and deploy.py's first run; AWS keeps its own copies in SSM.
# From my.telegram.org > API development tools:
API_ID=
API_HASH=
# Local runs only (deploy.py makes the Lambda's own): python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN=
# Optional. More chat ids, comma-separated, that the server must never read or send to (777000 always is):
# BLOCKED_CHATS=
# SEND_LIMIT_PER_HOUR=20
# ALLOWED_HOSTS=127.0.0.1:*,localhost:*
