# Copy to .env (never committed): for login.py, docker compose, and deploy.py's first run. On Lambda, deploy.py keeps
# its own copies in SSM; on a container host, give these to the host as secrets instead.
# From my.telegram.org > API development tools:
API_ID=
API_HASH=
# The session: leave unset to read TELEGRAM_SESSION_FILE (data/session.txt, from login.py), or paste it here.
# TELEGRAM_SESSION=

# Sign-in (recommended): this server's public https:// address, no path, and the three lines setup_signin.py writes
# to data/signin.env. The connector URL is then <PUBLIC_URL>/mcp.
# PUBLIC_URL=https://telegram.example.com
# LOGIN_PASSWORD_HASH=
# TOTP_SECRET=
# SIGNING_KEY=

# Or, or as well, a static token: 32+ random URL-safe characters, giving the URL <host>/<AUTH_TOKEN>/mcp.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# AUTH_TOKEN=

# Host headers to accept: PUBLIC_URL's host by default with sign-in, else only 127.0.0.1 and localhost.
# ALLOWED_HOSTS=telegram.example.com
# Optional. More chat ids, comma-separated, that the server must never read or send to (777000 always is):
# BLOCKED_CHATS=
# SEND_LIMIT_PER_HOUR=20
